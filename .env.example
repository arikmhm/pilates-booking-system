# Salin jadi .env.local, lalu isi. Jangan pernah commit .env.local.

# Database — cocok dengan docker-compose.yml untuk pengembangan lokal
DATABASE_URL=postgres://pilates:pilates@localhost:5432/pilates

# Penjaga endpoint job terjadwal (4 job, dipanggil Vercel Cron / crontab).
# Bangkitkan dengan: openssl rand -hex 32
CRON_SECRET=

# SMTP — magic link login dan notifikasi booking
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Studio Pilates <no-reply@contoh.id>"

# Alamat publik aplikasi, dipakai untuk menyusun tautan magic link
APP_URL=http://localhost:3000
