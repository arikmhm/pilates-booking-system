# Salin jadi .env.local, lalu isi. Jangan pernah commit .env.local.

# Database utama. Diisi otomatis oleh `neon link` untuk demo;
# di VPS klien diisi Postgres dari docker-compose.yml.
DATABASE_URL=postgres://pilates:pilates@localhost:5432/pilates

# Database untuk test. WAJIB menunjuk localhost — test menjalankan
# TRUNCATE CASCADE dan akan menolak jalan kalau host-nya bukan lokal.
TEST_DATABASE_URL=postgres://pilates:pilates@localhost:5432/pilates

# Penjaga endpoint job terjadwal (4 job, dipanggil Vercel Cron / crontab).
# Bangkitkan dengan: openssl rand -hex 32
CRON_SECRET=

# SMTP — magic link login dan notifikasi booking
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Studio Pilates <no-reply@contoh.id>"

# Alamat publik aplikasi, dipakai untuk menyusun tautan magic link
APP_URL=http://localhost:3000
